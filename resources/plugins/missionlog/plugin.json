            "mnemonic": "damage",
            "defaultValue": false
        },
        {
            "nameInUI": "Our losses (shot down, ejections, deaths)",
            "mnemonic": "losses",
            "defaultValue": true
        },
        {
            "nameInUI": "Crashes with nobody shooting",
            "mnemonic": "crashes",
            "defaultValue": true
        },
        {
            "nameInUI": "Takeoffs, landings and air spawns",
            "mnemonic": "flightstatus",
            "defaultValue": false
        },
        {
            "nameInUI": "Fighters moving to intercept (and how they found the target)",
            "mnemonic": "intercepts",
            "defaultValue": true
        },
        {
            "nameInUI": "Fighters monitoring a contact without committing to it",
            "mnemonic": "monitoring",
            "defaultValue": false
        },
        {
            "nameInUI": "Our flights launching on a target",
